{
  "productName": "nhs-spike",
  "version": "0.1.0",
  "identifier": "dev.local.nhs.spike",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nix Home Studio \u2014 prototype",
        "width": 1180,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}